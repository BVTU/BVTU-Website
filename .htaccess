RewriteEngine On

# Short link redirects: /go/{slug} → go.php?slug={slug}
RewriteRule ^go/([a-zA-Z0-9\-]+)/?$ go.php?slug=$1 [L,QSA]

# trustee-zones.html became .php so it can share the site's one header.
# The old address was handed out on paper and in the Documents menu, so it keeps
# working rather than 404ing.
RewriteRule ^trustee-zones\.html$ /trustee-zones.php [R=301,L]

# Configuration files are not for visitors. .user.ini would otherwise be served
# as plain text, and members/config.php holds the database password.
#
# documents-text.json joins them. It holds the extracted text of the public
# PDFs, so nothing in it is secret today — but it is read off disk by
# reindex.php and was never meant to be an endpoint, and if anything that
# needs a login is ever added to it by mistake, this is what stops it being
# handed to whoever asks.
<FilesMatch "^\.user\.ini$|^config\.php$|^documents-text\.json$">
  Require all denied
</FilesMatch>

# The staging copy is served from /test/ and must never reach a search result.
# Here rather than in PHP because it covers every response — images, PDFs, the
# static files PHP never sees — and because a public page has usually already
# sent its headers by the time any PHP of ours runs. Inert on live: no live URL
# begins with /test/.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/test/" BVTU_IS_TEST
  Header always set X-Robots-Tag "noindex, nofollow" env=BVTU_IS_TEST
</IfModule>
