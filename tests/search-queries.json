{
  "_comment": "What members type into the site search box, and what should come back. 'expect' matches a result title, case-insensitively; any one counts. Run with tools/search-eval.php, which queries the live index — so it measures what members actually get, not what we hope. Add a line whenever someone searches for something and gets nothing.",
  "queries": [
    { "q": "trustee",               "expect": ["Trustee Candidate"] },
    { "q": "trustees",              "expect": ["Trustee Candidate"] },
    { "q": "harassment",            "expect": ["Collective Agreement", "Health & Safety"] },
    { "q": "sick leave",            "expect": ["Collective Agreement", "Contract Assistant"] },
    { "q": "prep time",             "expect": ["Collective Agreement", "Contract Assistant", "Letters of Understanding"] },
    { "q": "preparation time",      "expect": ["Collective Agreement", "Contract Assistant"] },
    { "q": "constitution",          "expect": ["Constitution"] },
    { "q": "bylaws",                "expect": ["Constitution"] },
    { "q": "experience credit",     "expect": ["Experience Credit"] },
    { "q": "loan forgiveness",      "expect": ["Loan Forgiveness"] },
    { "q": "medical travel",        "expect": ["Medical Referral Travel", "Health & Dental"] },
    { "q": "salary grid",           "expect": ["Salary Grid"] },
    { "q": "collaboration grant",   "expect": ["Collaboration Grant"] },
    { "q": "collab days",           "expect": ["Collaboration Grant"] },
    { "q": "class size",            "expect": ["Collective Agreement", "Remedy Tracker"] },
    { "q": "seniority",             "expect": ["Collective Agreement", "TTOC"] },
    { "q": "ttoc pay",              "expect": ["TTOC", "Collective Agreement"] },
    { "q": "maternity leave",       "expect": ["Collective Agreement"] },
    { "q": "grievance",             "expect": ["Collective Agreement", "Contract Assistant"] },
    { "q": "pro d funding",         "expect": ["PRO-D", "Professional Development"] },
    { "q": "dental",                "expect": ["Health & Dental"] },
    { "q": "physiotherapy",         "expect": ["Health & Dental"] },
    { "q": "newsletter",            "expect": ["Newsletter"] },
    { "q": "all candidates forum",  "expect": ["Forum", "Candidates"] },
    { "q": "who is the president",  "expect": ["About", "Contact"] },
    { "q": "pension",               "expect": ["Collective Agreement", "Member Resources", "Benefits"] },
    { "q": "severance",             "expect": ["Collective Agreement"] },
    { "q": "early retirement",      "expect": ["Collective Agreement"] },
    { "q": "release time",          "expect": ["Collective Agreement", "Member Resources"] },
    { "q": "bargaining",            "expect": ["BCTF", "About", "Collective Agreement"] }
  ]
}
